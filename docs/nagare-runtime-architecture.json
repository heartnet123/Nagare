  "cards": [
    {
      "dot": "cyan",
      "title": "Request and stream semantics",
      "items": [
        "Default /api/** requests pass through Nitro; NUXT_PUBLIC_API_BASE bypasses that proxy.",
        "Chat sends JSON with POST Fetch and consumes Nagare SSE; chat mode disables the XML tool loop."
      ]
    },
    {
      "dot": "amber",
      "title": "State and trust boundaries",
      "items": [
        "SessionManager is injected at import; connect_db() initializes each SQLite connection; LLM request values override file and environment defaults.",
        "Nuxt gates pages, but backend auth and CSRF are selective; CORS permits credentials from http://localhost:3000."
      ]
    }
  ]
